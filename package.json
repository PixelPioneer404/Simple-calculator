{
  "name": "simple-calculator",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "tailwind": "tailwindcss -i ./input.css -o ./output.css --watch"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.4",
    "tailwind-scrollbar-hide": "^2.0.0",
    "tailwindcss": "^4.1.4"
  },
  "devDependencies": {
    "electron": "^28.1.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.user.simplecalculator",
    "productName": "Simple Calculator",
    "files": [
      "index.html",
      "output.css",
      "script.js",
      "main.js",
      "icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    }
  }
}
